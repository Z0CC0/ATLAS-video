{
  "name": "atlas-video",
  "version": "0.1.1",
  "description": "Four independent dials — compression (low/high), rigour (ask), check and silent — plus two subagents that keep searches and pages out of your conversation. Compresses without losing a fact, and refuses to start building before the goal is clear. This variant adds video made on this machine: written with HyperFrames, Remotion or Manim, or recorded from the screen with a camera that follows the cursor.",
  "author": {
    "name": "ZoCCo"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/atlas-activate.js\" --part 1",
            "timeout": 5,
            "statusMessage": "ATLAS"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/atlas-activate.js\" --part 2",
            "timeout": 5,
            "statusMessage": "ATLAS"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/atlas-activate.js\" --part 3",
            "timeout": 5,
            "statusMessage": "ATLAS"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/atlas-tracker.js\"",
            "timeout": 5,
            "statusMessage": "ATLAS"
          }
        ]
      }
    ]
  }
}
